{
  "name": "sitedrift",
  "version": "0.4.0",
  "description": "Visual review for local and hosted previews: compare DEV and LIVE with Split, Diff, SEO, response deltas, notes, and MCP.",
  "type": "module",
  "bin": {
    "sitedrift": "./dist/sitedrift.js",
    "sitedrift-mcp": "./dist/sitedrift-mcp.js"
  },
  "files": [
    "dist/",
    "sitedrift.mjs",
    "assets/viewer.html",
    "assets/viewer.css",
    "assets/icon.svg",
    "docs/CLOUDFLARE-PAGES.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run check:types && npm test && npm run build:package && npm run check:package",
    "check:package": "npm pack --dry-run",
    "check:types": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "build:package": "node scripts/build-package.ts",
    "prepack": "npm run build:package",
    "start": "node src/sitedrift.ts",
    "test": "node --test test/*.test.ts",
    "test:e2e:visual": "VISUAL=1 playwright test",
    "test:e2e:visual:update": "VISUAL=1 playwright test --update-snapshots",
    "docs:screenshots": "node test/capture-readme.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dev-tool",
    "visual-diff",
    "visual-regression",
    "staging",
    "production",
    "side-by-side",
    "proxy",
    "seo",
    "astro",
    "overlay",
    "cloudflare-pages",
    "cloudflare-workers",
    "preview",
    "csp"
  ],
  "author": "Joe Severino (https://github.com/joeseverino)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeseverino/sitedrift.git"
  },
  "homepage": "https://github.com/joeseverino/sitedrift#readme",
  "bugs": {
    "url": "https://github.com/joeseverino/sitedrift/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare-runtime.d.ts",
      "default": "./dist/cloudflare-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.19.0"
}
